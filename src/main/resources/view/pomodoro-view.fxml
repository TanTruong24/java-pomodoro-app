<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="appRoot"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.pomodoro.controller.PomodoroController"
           stylesheets="@../css/pomodoro.css"
           styleClass="app-root, theme-dark">
    <padding>
        <Insets top="18" right="20" bottom="20" left="20"/>
    </padding>

    <VBox maxWidth="1040" spacing="18" styleClass="app-shell">
        <FlowPane alignment="CENTER_LEFT" hgap="16" vgap="8">
            <VBox spacing="3">
                <Label text="Pomodoro" styleClass="app-title"/>
                <Label text="Focus with intention, rest at the right time."
                       styleClass="app-subtitle"/>
            </VBox>
            <Label text="FOCUS TIMER" styleClass="brand-badge"/>
            <Button fx:id="signInButton" text="Sign in" onAction="#handleSyncSignIn"
                    styleClass="secondary-button"/>
            <Button fx:id="syncButton" text="Sync now" onAction="#handleSyncNow"
                    styleClass="secondary-button"/>
            <Label fx:id="syncStatusLabel" text="Local only" wrapText="true"
                   maxWidth="260" styleClass="section-hint"/>
            <ComboBox fx:id="themeComboBox"
                      onAction="#handleThemeChanged"
                      prefWidth="105"
                      styleClass="theme-selector"/>
            <ToggleButton fx:id="settingsToggleButton"
                          text="⚙"
                          onAction="#handleToggleSettings"
                          styleClass="icon-button">
                <tooltip>
                    <Tooltip text="Timer settings"/>
                </tooltip>
            </ToggleButton>
        </FlowPane>

        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="Timer">
                <ScrollPane fitToWidth="true"
                            styleClass="responsive-scroll">
                  <content>
                    <FlowPane alignment="TOP_CENTER" hgap="22" vgap="22"
                              prefWrapLength="900" styleClass="tab-content">
                    <VBox alignment="CENTER" spacing="17"
                          minWidth="300" prefWidth="500" maxWidth="520"
                          styleClass="panel timer-panel">
                        <Label fx:id="modeLabel" styleClass="mode-label"/>

                        <StackPane minWidth="260" minHeight="260"
                                   maxWidth="260" maxHeight="260"
                                   styleClass="timer-circle">
                            <VBox alignment="CENTER" spacing="7">
                                <Label text="TIME REMAINING"
                                       styleClass="timer-caption"/>
                                <Label fx:id="timerLabel"
                                       styleClass="timer-label"/>
                            </VBox>
                        </StackPane>

                        <Label fx:id="cycleLabel" styleClass="cycle-label"/>

                        <FlowPane alignment="CENTER" hgap="10" vgap="10">
                            <Button text="Start" onAction="#handleStart"
                                    styleClass="primary-button"/>
                            <Button text="Pause" onAction="#handlePause"
                                    styleClass="secondary-button"/>
                            <Button text="Reset" onAction="#handleReset"
                                    styleClass="secondary-button"/>
                            <Button text="Skip" onAction="#handleSkip"
                                    styleClass="ghost-button"/>
                        </FlowPane>
                    </VBox>

                    <VBox fx:id="settingsPanel"
                          spacing="16" minWidth="260"
                          prefWidth="320" maxWidth="340"
                          visible="false" managed="false"
                          styleClass="panel settings-panel">
                        <VBox spacing="4">
                            <Label text="Settings" styleClass="section-title"/>
                            <Label text="Durations are measured in minutes."
                                   styleClass="section-hint"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="Focus" styleClass="field-label"/>
                            <Spinner fx:id="focusMinutesSpinner"
                                     maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="Short break" styleClass="field-label"/>
                            <Spinner fx:id="shortBreakMinutesSpinner"
                                     maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="Long break" styleClass="field-label"/>
                            <Spinner fx:id="longBreakMinutesSpinner"
                                     maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="Sessions before long break"
                                   styleClass="field-label"/>
                            <Spinner fx:id="cycleSpinner" maxWidth="Infinity"/>
                        </VBox>

                        <Button text="Save settings"
                                onAction="#handleSaveSettings"
                                maxWidth="Infinity"
                                styleClass="primary-button"/>
                        <Label fx:id="settingStatusLabel" wrapText="true"
                               styleClass="status-label"/>
                    </VBox>
                    </FlowPane>
                  </content>
                </ScrollPane>
            </Tab>

            <Tab text="History">
                <fx:include fx:id="historyView" source="history-view.fxml"/>
            </Tab>
        </TabPane>
    </VBox>
</StackPane>
